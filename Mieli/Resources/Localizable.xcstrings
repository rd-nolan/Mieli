        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”包含 %2$lld 个项目。删除将永久移除该文件夹及其全部内容，此操作不可撤销。"
          }
        }
      }
    },
